{
  "identifier": "default",
  "description": "Default capabilities for Bizforge desktop app",
  "windows": [
    "main",
    "splash"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-show",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "dialog:default",
    "fs:default",
    "shell:default",
    "store:default",
    "notification:default",
    "os:default",
    "process:default",
    "opener:default",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{
          "path": "$HOME/.bizforge/**"
        },
        {
          "path": "$APPDATA/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{
          "path": "$HOME/.bizforge/**"
        },
        {
          "path": "$APPDATA/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [{
          "path": "$HOME/.bizforge/**"
        },
        {
          "path": "$APPDATA/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{
          "path": "$HOME/.bizforge/**"
        },
        {
          "path": "$APPDATA/**"
        }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [{
        "name": "sh",
        "cmd": "sh",
        "args": true
      }]
    }
  ]
}