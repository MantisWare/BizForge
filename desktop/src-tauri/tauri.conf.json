{
  "$schema": "https://raw.githubusercontent.com/nickelpack/tauri/refs/heads/v2/crates/tauri-cli/schema.json",
  "productName": "Bizforge",
  "version": "0.1.0",
  "identifier": "com.miosa.bizforge",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://127.0.0.1:5200",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
        "label": "main",
        "title": "Bizforge",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false
      },
      {
        "label": "splash",
        "url": "splash.html",
        "title": "Bizforge",
        "width": 380,
        "height": 320,
        "decorations": false,
        "transparent": false,
        "resizable": false,
        "alwaysOnTop": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:9089 http://localhost:9089 ws://127.0.0.1:9089 ws://localhost:9089; img-src 'self' asset: blob: data: https://api.dicebear.com; media-src 'self' blob: asset:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": null,
      "providerShortName": null,
      "entitlements": null,
      "minimumSystemVersion": "10.15"
    },
    "category": "DeveloperTool",
    "shortDescription": "AI Workforce Command Center",
    "longDescription": "Bizforge is a desktop command center for managing AI agent workforces — deploy, orchestrate, and monitor autonomous agents across any workspace."
  },
  "plugins": {}
}