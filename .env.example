# ─── Bizforge Environment ─────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# The justfile loads .env automatically (set dotenv-load := true).
# NEVER commit the .env file — it is already in .gitignore.

# ─── Apple Code Signing (macOS distribution) ─────────────────────────────────
# Required for producing a signed, notarized .dmg that installs without
# Gatekeeper warnings. Leave blank for unsigned local dev builds.

# Your signing identity name, e.g. "Developer ID Application: Your Name (TEAMID)"
# Find it with: security find-identity -v -p codesigning
APPLE_SIGNING_IDENTITY=

# Base64-encoded .p12 certificate file
# Export from Keychain Access → right-click cert → Export → .p12
# Then: base64 -i certificate.p12 | pbcopy
APPLE_CERTIFICATE=

# Password used when exporting the .p12 certificate
APPLE_CERTIFICATE_PASSWORD=

# Your Apple ID email (the one enrolled in the Developer Program)
APPLE_ID=

# App-specific password for notarization (NOT your Apple ID password)
# Generate at: https://appleid.apple.com → Sign-In and Security → App-Specific Passwords
APPLE_PASSWORD=

# Your 10-character Apple Developer Team ID
# Find it at: https://developer.apple.com/account → Membership Details
APPLE_TEAM_ID=

# ─── Tauri Signing (update system) ───────────────────────────────────────────
# Key pair for Tauri's built-in updater. Generate with:
#   npx @tauri-apps/cli signer generate -w ~/.tauri/bizforge.key
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# ─── Backend ─────────────────────────────────────────────────────────────────
# DATABASE_URL=ecto://postgres:postgres@localhost:5432/bizforge_dev
# SECRET_KEY_BASE=
# PHX_HOST=localhost
# PORT=9089
