#!/bin/sh
# BizForge CLI — Headless workspace execution
#
# Usage: bizforge <command> [options]
#
# This script wraps the Mix release to dispatch CLI commands.
# It should be placed alongside the release's `bin/` directory.

set -e

SELF=$(readlink "$0" || echo "$0")
RELEASE_ROOT="$(cd "$(dirname "$SELF")/.." && pwd -P)"

# Source the release env if available
if [ -f "$RELEASE_ROOT/releases/RELEASES" ]; then
  export RELEASE_ROOT
  RELEASE_VSN=$(cut -d' ' -f2 "$RELEASE_ROOT/releases/start_erl.data")
  export RELEASE_VSN
fi

# Dispatch to the Elixir CLI module via release eval
exec "$RELEASE_ROOT/bin/bizforge" eval "Bizforge.CLI.main(System.argv())" -- "$@"
